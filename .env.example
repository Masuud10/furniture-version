# Supabase — public. Safe in the browser only because RLS is on every table.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never imported from a client component. Never prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Commerce
NEXT_PUBLIC_CURRENCY=KES
# Above this order total, an admin must record a confirmation call before
# production can start. KES 50,000 expressed in cents.
ORDER_CONFIRMATION_THRESHOLD_MINOR=5000000

# ---------------------------------------------------------------------------
# Local Postgres fallback (only needed while Docker is unavailable).
#
# scripts/db-local.sh applies the migrations, the seed and the hostile test
# suite to a plain PostgreSQL server using the shim in
# supabase/tests/harness/00_shim.sql. It reads these from .env.local.
#
# This is the superuser password for the PostgreSQL install on this machine.
# It never reaches the browser and must never be prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGDATABASE_TEST=furniture_local

# Set to false to drop the 16 invented sample products and list only
# merchant-supplied pieces. Flip this before launch.
NEXT_PUBLIC_INCLUDE_SAMPLE_CATALOGUE=true
